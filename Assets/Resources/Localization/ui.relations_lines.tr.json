{
  "rel.line.topic.weather.0": "Bu sabah sis bıçakla kesilecek gibiydi.",
  "rel.line.topic.weather.1": "Rüzgâr dönerse yarın yağmur gelir.",
  "rel.line.topic.weather.2": "Dizim sızlıyor, hava bozacak.",
  "rel.line.topic.weather.3": "Güneş yüzünü gösterdi, çamaşır kurur artık.",
  "rel.line.topic.weather.4": "Geceler serinledi, yorganı çıkarma vakti.",
  "rel.line.topic.weather.5": "Bulutlar alçaldı, kırlangıçlar da öyle.",
  "rel.line.topic.weather.6": "Ayaz kapıya dayandı, odunu bol tutun.",
  "rel.line.topic.weather.7": "Bu yağmur ekine bereket getirir.",
  "rel.line.topic.weather.8": "Fırtınada çatı uçmasın diye dua ettim.",
  "rel.line.topic.weather.9": "Böyle güzel havada içeride oturulmaz.",
  "rel.line.topic.harvest.0": "Bu yıl başaklar dolgun, değirmen bayram eder.",
  "rel.line.topic.harvest.1": "Kargalar tarlamı mesken tuttu.",
  "rel.line.topic.harvest.2": "Toprak yorulmuş, gübre ister.",
  "rel.line.topic.harvest.3": "Yabani ot ekinden hızlı büyüyor vallahi.",
  "rel.line.topic.harvest.4": "Ata tohumunu sakladın mı?",
  "rel.line.topic.harvest.5": "Hasat erken başlarsa elimiz rahatlar.",
  "rel.line.topic.harvest.6": "Lahanalar dolu yedi, yarısı gitti.",
  "rel.line.topic.harvest.7": "Sulamayı aksatma, kök susuz kalmasın.",
  "rel.line.topic.harvest.8": "Nadasa bırakmak lazım o tarlayı.",
  "rel.line.topic.harvest.9": "Ambar dolunca içim rahat ediyor.",
  "rel.line.topic.animals.0": "İnek bu sabah iki kova süt verdi.",
  "rel.line.topic.animals.1": "Kurt sesi duydum dün gece.",
  "rel.line.topic.animals.2": "Tavuklar yine çite tünemiş.",
  "rel.line.topic.animals.3": "Kuzular sürüye karıştı, ayıramıyorum.",
  "rel.line.topic.animals.4": "Atın nalı gevşemiş, demirciye götüreceğim.",
  "rel.line.topic.animals.5": "Kedi fareyi bırakıp güneşe yattı.",
  "rel.line.topic.animals.6": "Köpek bütün gece havladı, bir şey sezdi.",
  "rel.line.topic.animals.7": "Arılar bu yıl uslu.",
  "rel.line.topic.animals.8": "Keçi yine bostana girmiş.",
  "rel.line.topic.animals.9": "Yayla göçü yaklaştı, sürü huysuzlanıyor.",
  "rel.line.topic.food.0": "Tarhanayı bu yıl erken kuruttum.",
  "rel.line.topic.food.1": "Ekşi maya tuttu, ekmek kabardı.",
  "rel.line.topic.food.2": "Pekmez kazanı kaynıyor, kokusu sokağa taştı.",
  "rel.line.topic.food.3": "Anamın yahnisini kimse yapamaz.",
  "rel.line.topic.food.4": "Peynir bu kış iyi olgunlaştı.",
  "rel.line.topic.food.5": "Salçayı kaynatırken kıvamı kaçırma.",
  "rel.line.topic.food.6": "Bulgur pilavı soğanla güzel olur.",
  "rel.line.topic.food.7": "Kilere turşu kurdum, renk renk.",
  "rel.line.topic.food.8": "Helvanın kokusu beni çocukluğuma götürdü.",
  "rel.line.topic.food.9": "Taze balık kızarınca bütün köy acıkır.",
  "rel.line.topic.mine.0": "Madende bugün bir damar gördüm.",
  "rel.line.topic.mine.1": "Galeride su sızıyor, destek lazım.",
  "rel.line.topic.mine.2": "Kömür tozu ciğere iyi gelmiyor.",
  "rel.line.topic.mine.3": "Rayı biraz daha uzatırsak yük kolaylaşır.",
  "rel.line.topic.mine.4": "Derinde taş daha sert.",
  "rel.line.topic.mine.5": "Meşale sönünce insanın içi kararıyor.",
  "rel.line.topic.mine.6": "Göçükten beri ağzıma bez bağlıyorum.",
  "rel.line.topic.mine.7": "Bakır az ama değerli.",
  "rel.line.topic.mine.8": "Madenden çıkınca güneş gözümü alıyor.",
  "rel.line.topic.mine.9": "Kazmanın ucu körelmiş, bilemeli.",
  "rel.line.topic.craft.0": "Yeni rendeyle tahta ipek gibi oluyor.",
  "rel.line.topic.craft.1": "Körük iyi çekerse demir çabuk kızarır.",
  "rel.line.topic.craft.2": "Tezgâhta kumaş yarım kaldı.",
  "rel.line.topic.craft.3": "Çömlek fırında çatladı, yazık.",
  "rel.line.topic.craft.4": "Eyerin dikişi sağlam olmalı.",
  "rel.line.topic.craft.5": "Usta eli belli oluyor.",
  "rel.line.topic.craft.6": "Mumu yavaş dökersen kabarcık olmaz.",
  "rel.line.topic.craft.7": "Testereyi bileyletmem lazım.",
  "rel.line.topic.craft.8": "Bu sandığı torunlarım kullanacak.",
  "rel.line.topic.craft.9": "Ağacın damarına göre rende çekilir.",
  "rel.line.topic.children.0": "Bizim küçük bugün ilk adımını attı.",
  "rel.line.topic.children.1": "Çocuklar topaçla oynamaktan bıkmıyor.",
  "rel.line.topic.children.2": "Bizim oğlan çırak olmak istiyor.",
  "rel.line.topic.children.3": "Kızım harfleri öğreniyor, maşallah.",
  "rel.line.topic.children.4": "Çocuk dediğin yaramaz olur.",
  "rel.line.topic.children.5": "Bizimkiler ağaç evden inmiyor.",
  "rel.line.topic.children.6": "Masal anlatmadan uyumuyorlar.",
  "rel.line.topic.children.7": "Ergenlik zor yaş, sabır lazım.",
  "rel.line.topic.children.8": "Çocuğu yalnız bırakmak olmaz.",
  "rel.line.topic.children.9": "Torun sevgisi başka.",
  "rel.line.topic.festival.0": "Şenliğe az kaldı, hazırlık var.",
  "rel.line.topic.festival.1": "Geçen panayırda atlar ne yarıştı!",
  "rel.line.topic.festival.2": "Bu yıl halayı kim çekecek?",
  "rel.line.topic.festival.3": "Bereket Sofrası'na ne götüreceğiz?",
  "rel.line.topic.festival.4": "Kış Gecesi masallarını özledim.",
  "rel.line.topic.festival.5": "Tohum Şenliği'nde dilek tuttum.",
  "rel.line.topic.festival.6": "Hasat Şenliği'nde en iri kabak bizimdi.",
  "rel.line.topic.festival.7": "Davul sesi duyunca yerimde duramıyorum.",
  "rel.line.topic.festival.8": "Şenlikte küsler barışır derler.",
  "rel.line.topic.festival.9": "Bu yıl yarışmaya katılacağım.",
  "rel.line.topic.trade.0": "Tuz pahalandı, tüccar keyfine bakıyor.",
  "rel.line.topic.trade.1": "Pazarda yün para etmedi bugün.",
  "rel.line.topic.trade.2": "Gezgin tüccar uzak diyarlardan söz etti.",
  "rel.line.topic.trade.3": "Pazarlık etmeyen kaybeder.",
  "rel.line.topic.trade.4": "Kervan gelince köy şenlenir.",
  "rel.line.topic.trade.5": "Siparişi zamanında yetiştirmek lazım.",
  "rel.line.topic.trade.6": "Akçeyi biriktirip toprak alacağım.",
  "rel.line.topic.trade.7": "Borç yiğidin kamçısıdır derler.",
  "rel.line.topic.trade.8": "Tezgâhımda bugün yemekler kapış kapış gitti.",
  "rel.line.topic.trade.9": "Fiyatlar mevsime göre değişiyor.",
  "rel.line.topic.hunt.0": "Ormanda karaca izi gördüm.",
  "rel.line.topic.hunt.1": "Ayıdan uzak dur, yavrusu varsa hele.",
  "rel.line.topic.hunt.2": "Tuzağa tavşan düşmüş.",
  "rel.line.topic.hunt.3": "Yay telini yeniledim.",
  "rel.line.topic.hunt.4": "Yavrulu hayvan avlanmaz, ayıptır.",
  "rel.line.topic.hunt.5": "Göl kıyısında yaban ördekleri var.",
  "rel.line.topic.hunt.6": "Mantar toplarken yolumu kaybettim.",
  "rel.line.topic.hunt.7": "Böğürtlenler olgunlaştı.",
  "rel.line.topic.hunt.8": "Ulu çınarın dibinde ne güzel gölge var.",
  "rel.line.topic.hunt.9": "Ormanın sesi insanı dinlendiriyor.",
  "rel.line.topic.home.0": "Duvarı badanaladım, ev aydınlandı.",
  "rel.line.topic.home.1": "Ocak is yaptı, baca temizlenmeli.",
  "rel.line.topic.home.2": "Yeni kilim serdik, odanın havası değişti.",
  "rel.line.topic.home.3": "Saksıdaki fesleğen güzel kokuyor.",
  "rel.line.topic.home.4": "Çatıdan damlıyor, saz lazım.",
  "rel.line.topic.home.5": "Ev dediğin sıcak olmalı.",
  "rel.line.topic.home.6": "Raf yükü kaldırmadı, her şey yere döküldü.",
  "rel.line.topic.home.7": "Pencere önünde oturmayı seviyorum.",
  "rel.line.topic.home.8": "Ev yarışmasında bizim ev de olsun isterim.",
  "rel.line.topic.home.9": "Misafir odasını hazırladım.",
  "rel.line.topic.season.0": "İlkbahar gelince içim kıpır kıpır.",
  "rel.line.topic.season.1": "Yazın sıcağında gölge altın değerinde.",
  "rel.line.topic.season.2": "Güz yaprakları yolu kapladı.",
  "rel.line.topic.season.3": "Kışa hazırlık yaptın mı?",
  "rel.line.topic.season.4": "Mevsim dönerken herkes hastalanıyor.",
  "rel.line.topic.season.5": "Bu mevsim çok çabuk geçti.",
  "rel.line.topic.season.6": "Kar yağınca köy susuyor.",
  "rel.line.topic.season.7": "Yayla zamanı yaklaştı.",
  "rel.line.topic.season.8": "Bağbozumu en sevdiğim zaman.",
  "rel.line.topic.season.9": "Her mevsimin bir derdi var.",
  "rel.line.joke.0": "Hoca'ya sormuşlar: Dünyanın merkezi neresi? Eşeğimin bastığı yer, demiş.",
  "rel.line.joke.1": "Komşu kazanını istemiş, geri getirince içinde küçük bir tencere varmış: kazan doğurdu, demiş.",
  "rel.line.joke.2": "Tavuk yumurtlamış, horoz övünmüş.",
  "rel.line.joke.3": "Eşek de bilir neyin ne olduğunu, sormaya utanır.",
  "rel.line.joke.4": "Demirci şaka yapmaz, demir soğumadan döver.",
  "rel.line.joke.5": "Değirmenci ekmeği tatmadan satmaz, tatarken yarısı biter.",
  "rel.line.joke.6": "Balıkçı yalan söylemez, balık küçülür.",
  "rel.line.joke.7": "Kedi yetişemediği ciğere mundar dermiş.",
  "rel.line.joke.8": "Keçi dağa kaçmış, çoban ardından türkü söylemiş.",
  "rel.line.joke.9": "Koyun sayarken uyuyakaldım, koyunlar da beni saydı.",
  "rel.line.joke.10": "Horoz öttü diye sabah olmaz ama bizimki inanıyor.",
  "rel.line.joke.11": "Ağaca çıkan keçinin dalına bastı, ikisi birden düştü.",
  "rel.line.joke.12": "Kör kadı, sağır şahit, ne de güzel mahkeme!",
  "rel.line.joke.13": "Bizim eşek konuşsa ilk bana küser.",
  "rel.line.joke.14": "Pazarda bir horoz aldım, sabahları saati kendi ayarlıyor.",
  "rel.line.joke.15": "Kazan kaynadı, ben uyudum, yemek de beni beklemedi.",
  "rel.line.joke.16": "Ayı kovana girmiş, arılar dağdan kaçmış.",
  "rel.line.joke.17": "Kurt dumanlı havayı sever, ben de çorbayı.",
  "rel.line.joke.18": "Tüccar terazisini şaşırınca kendini tartmış.",
  "rel.line.joke.19": "Fare kediye ders vermiş, kedi dinlemiş, sonra yemiş.",
  "rel.line.joke.20": "Çiftçi yağmur için dua etmiş, sel gelmiş, bir dahakine azını iste demişler.",
  "rel.line.joke.21": "Sırtımdaki küfeyi unuttum, bütün gün aradım.",
  "rel.line.joke.22": "Tavşan uyumuş, kaplumbağa da uyumuş, yarış hâlâ sürüyor.",
  "rel.line.joke.23": "Bizim köpek hırsıza havlamaz, mutfağa havlar.",
  "rel.line.joke.24": "Değirmen dönüyor ama un nerede, kimse bilmiyor.",
  "rel.line.joke.25": "Yorganı ateşe atmışlar, pirelerden kurtulduk diye sevinmişler.",
  "rel.line.joke.26": "Yaşlı keçi nane yaprağını sever derler, bizimki tütsülük kafası.",
  "rel.line.joke.27": "Kuyuya taş atan deliyi kırk akıllı çıkaramaz.",
  "rel.line.joke.28": "Kazı yeni almışım, beni kovalıyor, kim kimin sahibi belli değil.",
  "rel.line.joke.29": "Eşek hoşaftan ne anlar, ben anlarım!",
  "rel.line.story.0": "Dedem anlatırdı, bu köyün ilk kuyusunu yedi kardeş kazmış.",
  "rel.line.story.1": "Bir zamanlar değirmen yanmış, köy hep birlikte yeniden kurmuş.",
  "rel.line.story.2": "Kış Gecesi'nde kurtla dans eden çobanın masalını bilir misin?",
  "rel.line.story.3": "Ulu çınarı kimin diktiğini kimse bilmez, ama ben bilirim.",
  "rel.line.story.4": "Atsız şövalye bu yoldan geçmiş, kılıcını sabana çevirmiş.",
  "rel.line.story.5": "Benim gençliğimde kar o kadar yağardı ki kapıyı açamazdık.",
  "rel.line.story.6": "Ninem derdi ki: ekmeği israf eden bereketini yitirir.",
  "rel.line.story.7": "Bir keresinde bir koyun konuşmuş, kimse inanmamış.",
  "rel.line.song.0": "Dere boyu kavaklar, yaprağı dökülür...",
  "rel.line.song.1": "Yayla yolu taşlı, gelin ayağı kanar...",
  "rel.line.song.2": "Ağ elinde kına var, gönlümde bir yâr var...",
  "rel.line.song.3": "Değirmen döner, un olur, hasretim bitmez...",
  "rel.line.song.4": "Ay doğar, yıldız kayar, sen gelirsin diye bakarım...",
  "rel.line.song.5": "Harman yerinde rüzgâr eser, başak sarı, gönül deli...",
  "rel.line.react.laugh.0": "Hahaha!",
  "rel.line.react.laugh.1": "Gülmekten karnım ağrıdı!",
  "rel.line.react.laugh.2": "Vay, iyiymiş!",
  "rel.line.react.laugh.3": "Hıh hıh hıh...",
  "rel.line.react.laugh.4": "Bunu bizimkine de anlatacağım.",
