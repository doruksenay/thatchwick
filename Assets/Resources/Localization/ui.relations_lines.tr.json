  "rel.line.gossip.word_given.1": "Tuzlu kahveyi yüzünü buruşturmadan içmiş!",
  "rel.line.gossip.donation.0": "{a} aşevine bağış yapmış, ne cömert.",
  "rel.line.gossip.generic.0": "{a} hakkında bir şey duydum...",
  "rel.line.gossip.generic.1": "Köyde bir haber dolaşıyor.",
  "rel.line.gossip.generic.2": "Bilmem duydun mu ama...",
  "rel.line.argue.0": "Bana bak, böyle olmaz!",
  "rel.line.argue.1": "Sen kim oluyorsun da!",
  "rel.line.argue.2": "Yeter artık, sabrım taştı!",
  "rel.line.argue.3": "Hep aynı şey!",
  "rel.line.argue.4": "Sözümü kesme!",
  "rel.line.argue.5": "Bunu sana kaç kez söyledim!",
  "rel.line.argue_back.0": "Asıl sen kimsin!",
  "rel.line.argue_back.1": "Bağırma bana!",
  "rel.line.argue_back.2": "Haksızsın!",
  "rel.line.argue_back.3": "Ben de bıktım!",
  "rel.line.argue_back.4": "Sus, herkes bakıyor!",
  "rel.line.jab.0": "{b}, senin ekinin yine mi kurumuş?",
  "rel.line.jab.1": "{b}, o kıyafetle mi çıktın dışarı?",
  "rel.line.jab.2": "{b}'nin yemeğini yiyen bir daha gelmez.",
  "rel.line.jab.3": "{b} yine çok bilmiş.",
  "rel.line.jab.4": "{b}, sen de az değilsin ha.",
