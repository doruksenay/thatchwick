<Project Sdk="Microsoft.NET.Sdk">
  <!-- Yerleşim raporu (docs/yerlesim-ilerleme.md): yeni oyunun dünyasını Unity'siz kurar, doğrulayıcıyı çalıştırır,
       ihlalleri bölgeye ve kurala göre sayar. Çalıştırma: dotnet run (proje: tools/layout-report); ayrıntı için argüman list ya da md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0169;CS0414;CS0067;CS0162;CS0168;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Hooks.cs" />
    <Compile Include="Dump.cs" />
  </ItemGroup>
</Project>
